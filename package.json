{
  "name": "online-cab-booking",
  "version": "1.0.0",
  "description": "CabGo – Modern Multi-Tenant Urban Transit & Dispatch Platform",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently --names \"SRV,CLIENT\" -c \"yellow,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/server.js",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "test": "node e2e_test.js",
    "db:setup": "node scripts/setup-tidb.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@tidbcloud/serverless": "^0.3.0",
    "alasql": "^4.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "keywords": [
    "cab",
    "booking",
    "react",
    "express",
    "socket.io",
    "nodejs",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
